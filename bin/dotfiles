#!/bin/bash

function show_help {
    echo "dotfiles - Dotfiles management solution with ansible"
    echo ""
    echo "Usage: dotfiles [-b PLAYBOOK] [TAG...]"
    echo "       dotfiles [un]install"
    echo "       dotfiles help"
    echo "       dotfiles -h"
    echo ""
    echo "Commands:"
    echo "  install       add this script to the PATH"
    echo "  uninstall     remove this script from the PATH"
    echo "  update        run git pull in \$HOME/.dotfiles"
    echo "  help          same as -h"
    echo ""
    echo "Arguments:"
    echo "  TAG...        one or more tags passed directly to ansible-playbook with '-t'"
    echo ""
    echo "Options:"
    echo "  -b PLAYBBOK   the PLAYBOOK to execute, without yml extension (default: main)"
    echo "                NOTE: this option must be used before any TAG arguments"
    echo "  -h            show this help menu"
}

if [ "$1" = "help" ]; then
    show_help
    exit 0
elif [ "$1" = "install" ]; then
    ctx="dotfiles install"
    target="/usr/local/bin/dotfiles"
    if [ -e $target ]; then
        echo "dotfiles: cannot install (already installed)"
        exit 0
    fi

    src="$(realpath $0)"
    if [ -z $src ]; then
        echo "error: could not determine path to dotfiles script" >&2
        exit 1
    fi

    echo "linking $src -> $target"
    sudo ln -s $src $target
    exit 0
elif [ "$1" = "uninstall" ]; then
    if [ -e "/usr/local/bin/dotfiles" ]; then
        sudo rm "/usr/local/bin/dotfiles"
        echo "dotfiles: successfully uninstalled dotfiles"
    else
        echo "dotfiles: cannot uninstall (not installed)"
    fi
    exit 0
elif [ "$1" = "update" ]; then
    git -C $HOME/.dotfiles pull
    chmod u+x $HOME/.dotfiles/bin/dotfiles
    exit 0
fi

playbook=""
while getopts "hb:" opt 2>/dev/null; do
    case $opt in
        b)
            playbook="$OPTARG"
            ;;
        h)
            show_help
            exit 0
            ;;
        \?)
            echo "error: invalid option: -$OPTARG" >&2
            show_help
            exit 1
            ;;
        :)
            echo "error: -$OPTARG requires an argument" >&2
            show_help
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

# check for a default playbook
if [ -z $playbook ]; then
    if [ -f "/etc/dotfiles.conf" ]; then
        playbook="$(awk -F'=' '/playbook[[:space:]]=/ { sub(/^[ \t]*/, "", $2); print $2 }' /etc/dotfiles.conf)"
    fi
fi

# if still nothing, use default
if [ -z $playbook ]; then
    playbook="main"
fi

playbook_path="$HOME/.dotfiles/$playbook.yml"
if [ ! -f $playbook_path ]; then
    echo "error: playbook '$playbook' does not exist (expected $playbook_path)" >&2
    exit 1
fi

echo "Executing playbook: $playbook_path"
if [ $# -gt 0 ]; then
    echo "Using tags:"

    # fix missing comma, can get annoying to type out
    tags=""
    for t in "$@"; do
        echo "  - $t"
        tags="${tags},$t"
    done

    ansible-playbook -K -i localhost, -c local $playbook_path -t $tags
else
    ansible-playbook -K -i localhost, -c local $playbook_path
fi
