#!/usr/bin/env python3

import argparse
import shutil
import os
import subprocess
import sys
from pathlib import Path

DF_DIR = Path("/opt/dotfiles")
DF_BIN_FILE = Path("/usr/local/bin/dotfiles")
DF_CONF_FILE = Path("/etc/dotfiles.conf")


def bail(msg):
    print(f"error: {msg}", file=sys.stderr)
    exit(1)


def get_playbook_path(playbook: str | None) -> str:
    if not playbook and DF_CONF_FILE.is_file():
        with open(DF_CONF_FILE) as f:
            for line in f:
                if "playbook" in line:
                    parts = line.strip().split()
                    if len(parts) >= 2:
                        playbook = parts[1]
                        break

    if not playbook:
        playbook = "main"

    playbook_path = DF_DIR.joinpath(f"{playbook}.yml")

    if not playbook_path.is_file():
        bail(
            f"error: playbook '{playbook}' does not exist "
            f"(expected '{playbook_path}' to be a file)"
        )

    return playbook_path


def cmd_uninstall(purge: bool):
    if os.geteuid() != 0:
        bail("'uninstall' command requires root")

    if DF_BIN_FILE.exists():
        print(f"removing link: {DF_BIN_FILE}")
        DF_BIN_FILE.unlink()

    if purge and DF_CONF_FILE.exists():
        print(f"removing config file: {DF_CONF_FILE}")
        DF_CONF_FILE.unlink()

    if DF_DIR.exists():
        print(f"removing dotfiles directory: {DF_DIR}")
        shutil.rmtree(DF_DIR)


def cmd_update():
    if os.geteuid() != 0:
        bail("'uninstall' command requires root")

    subprocess.run(["git", "-C", str(DF_DIR.resolve()), "pull"], check=True)


def cmd_list(playbook: str | None):
    pbpath = get_playbook_path(playbook)
    if not pbpath.exists():
        bail(f"playbook '{pbpath}' does not exist")

    print(f"Tags in {pbpath}:")
    with open(pbpath) as f:
        in_roles = False
        seen = set()
        for line in f:
            if "roles:" in line:
                in_roles = True
            s = line.strip()
            if in_roles and s.startswith("- ") and ":" not in s:
                tag = s.lstrip("- ").strip()
                if tag and tag not in ("never", "always"):
                    seen.add(tag)
        for tag in sorted(seen):
            print(f"  - {tag}")


def cmd_run(playbook: str | None, tags: list[str]):
    pbpath = get_playbook_path(playbook)
    print(f"Executing playbook: {pbpath}")

    ansible_flags = []
    if os.geteuid() != 0:
        ansible_flags.append("-K")

    if tags:
        print("Using tags:")
        print("\n".join(f"  - {t}" for t in tags))
        ansible_flags += ["-t", ",".join(tags)]

    cmd = [
        "ansible-playbook",
        "-i",
        "localhost,",
        "-c",
        "local",
        pbpath,
    ] + ansible_flags
    subprocess.run(cmd, check=True)


def main():
    parser = argparse.ArgumentParser(
        description="Dotfiles management solution with ansible"
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("install", help="install the dotfiles script")
    p_uninstall = subparsers.add_parser(
        "uninstall", help="remove installed script and config"
    )
    p_uninstall.add_argument(
        "-p", "--purge", help="delete config files when uninstalling"
    )
    subparsers.add_parser("update", help="update dotfiles repository")
    p_list = subparsers.add_parser(
        "list", aliases=["ls"], help="list tags in a playbook"
    )
    p_list.add_argument("playbook", nargs="?", help="optional playbook name")
    p_run = subparsers.add_parser("run", help="run a playbook")
    p_run.add_argument("-b", "--playbook", help="specify playbook to run")
    p_run.add_argument(
        "tags", nargs="*", help="optional tags to pass to ansible with -t"
    )
    subparsers.add_parser("help", help="show this help")

    if len(sys.argv) == 1:
        parser.print_help()
        exit(0)

    args = parser.parse_args()

    if args.command == "help":
        parser.print_help()
    elif args.command == "uninstall":
        cmd_uninstall(args.purge)
    elif args.command == "update":
        cmd_update()
    elif args.command in ("list", "ls"):
        cmd_list(getattr(args, "playbook", None))
    elif args.command == "run":
        cmd_run(args.playbook, args.tags)
    else:
        bail(f"unknown command '{args.command}'")


if __name__ == "__main__":
    main()
