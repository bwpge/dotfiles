#!/bin/bash

set -eo pipefail

dfconf='/etc/dotfiles.conf'
dfpath="$(python3 -c 'import sys,pathlib;print(pathlib.Path(sys.argv[1]).resolve().parent.parent)' $0)"

function show_help {
    echo "dotfiles - Dotfiles management solution with ansible"
    echo ""
    echo "Usage: dotfiles run [-b PLAYBOOK] [TAG...]"
    echo "       dotfiles [un]install"
    echo "       dotfiles list|ls [PLAYBOOK]"
    echo "       dotfiles help"
    echo "       dotfiles -h"
    echo ""
    echo "Commands:"
    echo "  run           execute with given playbook and tags"
    echo "  install       add this script to the PATH and create config files"
    echo "  uninstall     uninstall this script and delete associated files"
    echo "  update        run git pull in dotfile directory"
    echo "  list|ls       show available tags in a playbook"
    echo "  help          same as -h"
    echo ""
    echo "Arguments:"
    echo "  TAG...        one or more tags passed directly to ansible-playbook with '-t'"
    echo ""
    echo "Options:"
    echo "  -b PLAYBBOK   the PLAYBOOK to execute, without yml extension (default: main)"
    echo "                NOTE: this option must be used before any TAG arguments"
    echo "  -h            show this help menu"
}

function get_playbook_path {
    playbook="$1"

    # check for a default playbook
    if [ -z "$playbook" ]; then
        if [ -f "$dfconf" ]; then
            playbook="$(awk '/playbook/ { print $2 }' $dfconf)"
        fi
    fi

    # if still nothing, use default
    if [ -z $playbook ]; then
        playbook="main"
    fi

    playbook_path="$dfpath/$playbook.yml"
    if [ ! -f $playbook_path ]; then
        echo "error: playbook '$playbook' does not exist (expected '$playbook_path' to be a file)" >&2
        exit 1
    fi

    echo "$playbook_path"
}

__sudo="sudo"
if [ "$(id -u)" -eq 0 ]; then
    __sudo=""
fi

if [ "$1" = "help" ] || [ "$1" = "" ]; then
    show_help
    exit 0
elif [ "$1" = "install" ]; then
    ctx="dotfiles install"
    target="/usr/local/bin/dotfiles"
    if [ -e $target ]; then
        echo "dotfiles: cannot install (already installed)"
        exit 0
    fi

    src="$(realpath $0)"
    if [ -z $src ]; then
        echo "error: could not determine path to dotfiles script" >&2
        exit 1
    fi

    echo "creating link: $src -> $target"
    $__sudo ln -s $src $target
    echo "creating config file: $dfconf"
    $__sudo touch $dfconf
    exit 0
elif [ "$1" = "uninstall" ]; then
    if [ -e "/usr/local/bin/dotfiles" ]; then
        $__sudo rm "/usr/local/bin/dotfiles"
        $__sudo rm "$dfconf"
        echo "dotfiles: successfully uninstalled dotfiles"
    else
        echo "dotfiles: cannot uninstall (not installed)"
    fi
    exit 0
elif [ "$1" = "update" ]; then
    git -C $dfpath pull
    exit 0
elif [ "$1" = "list" ] || [ "$1" = "ls" ]; then
    pbpath="$(get_playbook_path $2)"
    if [ ! -f "$pbpath" ]; then
        echo "error: "
        exit 1
    fi

    echo "Tags in $pbpath:"
    awk '/roles:/,0' "$pbpath" | grep '\- [a-zA-Z]' | grep -vE 'role:|never' | sed 's/[[:space:]]*- /  - /' | sort | uniq
    exit 0
elif [ "$1" != "run" ]; then
    echo "error: unknown command '$1'"
    exit 1
fi

playbook=""
while getopts "hb:" opt 2>/dev/null; do
    case $opt in
        b)
            playbook="$OPTARG"
            ;;
        h)
            show_help
            exit 0
            ;;
        \?)
            echo "error: invalid option: -$OPTARG" >&2
            show_help
            exit 1
            ;;
        :)
            echo "error: -$OPTARG requires an argument" >&2
            show_help
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

playbook_path="$(get_playbook_path $playbook)"
echo "Executing playbook: $playbook_path"

ansible_flags=''
if [ "$(id -u)" -ne 0 ]; then
    ansible_flags="-K"
fi

if [ $# -gt 0 ]; then
    echo "Using tags:"

    ansible_flags="${ansible_flags} -t "
    for t in "$@"; do
        echo "  - $t"
        ansible_flags="${ansible_flags},$t"
    done
fi

ansible-playbook -i localhost, -c local $playbook_path $ansible_flags
