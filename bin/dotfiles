#!/usr/bin/env python3

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

DF_DIR = Path(__file__).resolve().parent.parent
DF_BIN_FILE = DF_DIR.joinpath("bin/dotfiles")
DF_CONF_FILES = [
    DF_DIR.joinpath("dotfiles.conf"),
    Path("/etc/dotfiles.conf"),
]

CONFIG = {}


def bail(msg):
    print(f"error: {msg}", file=sys.stderr)
    exit(1)


def load_config():
    for p in DF_CONF_FILES:
        if not p.is_file():
            continue

        with open(p) as f:
            for line in f:
                s = line.strip()
                if s.startswith("#") or not line:
                    continue

                splits = s.split(maxsplit=1)
                if len(splits) != 2:
                    bail(f"config error: invalid syntax: '{line}'")

                k = splits[0].strip()
                v = splits[1].strip()
                CONFIG[k] = v
            return


def get_playbook_path(playbook: str | None) -> str:
    if not playbook:
        playbook = CONFIG.get("playbook", "main")
    playbook_path = DF_DIR.joinpath(f"{playbook}.yml")

    if not playbook_path.is_file():
        bail(
            f"error: playbook '{playbook}' does not exist "
            f"(expected '{playbook_path}' to be a file)"
        )

    return playbook_path


def cmd_uninstall(purge: bool):
    if DF_BIN_FILE.exists():
        print(f"removing link: {DF_BIN_FILE}")
        DF_BIN_FILE.unlink()

    if purge:
        for p in DF_CONF_FILES:
            if p.exists():
                print(f"removing config file: {p}")
                try:
                    p.unlink()
                except Exception as e:
                    print(f"failed to remove '{p}': {e}")

    if DF_DIR.exists():
        print(f"removing dotfiles directory: {DF_DIR}")
        shutil.rmtree(DF_DIR)


def cmd_update():
    git_cmd = f"git -C {DF_DIR}"
    subprocess.run(
        f"{git_cmd} fetch && {git_cmd} log main..origin/main --oneline | grep -q . && {git_cmd} reset --hard origin/main || echo 'Already up to date.'",
        shell=True,
        check=False,
    )


def cmd_list(playbook: str | None, tags: list[str], skip_tags: list[str]):
    pbpath = get_playbook_path(playbook)
    if not pbpath.exists():
        bail(f"playbook '{pbpath}' does not exist")

    ansible_flags = []
    if tags:
        ansible_flags.extend(["-t", ",".join(tags)])
    if skip_tags:
        ansible_flags.extend(["--skip-tags", ",".join(skip_tags)])

    cmd = [
        "ansible-playbook",
        pbpath,
        "-i",
        "localhost,",
        "--list-tags",
        "--list-tasks",
    ]
    cmd.extend(ansible_flags)
    subprocess.run(cmd, cwd=DF_DIR, check=True)


def cmd_run(playbook: str | None, tags: list[str], skip_tags: list[str]):
    pbpath = get_playbook_path(playbook)
    print(f"Executing playbook: {pbpath}")

    ansible_flags = []
    if os.geteuid() != 0:
        pw = CONFIG.get("ansible_password")
        ask_pass = CONFIG.get("ask_pass")
        if pw:
            ansible_flags.extend(["-e", f"ansible_become_pass='{pw}'"])
        # default on macos is to not ask for password since it's usually not needed
        elif ask_pass or sys.platform != "darwin":
            ansible_flags.append("-K")

    if tags:
        print("Using tags:")
        print("\n".join(f"  - {t}" for t in tags))
        ansible_flags.extend(["-t", ",".join(tags)])
    if skip_tags:
        print("Skipping tags:")
        print("\n".join(f"  - {t}" for t in skip_tags))
        ansible_flags.extend(["--skip-tags", ",".join(skip_tags)])

    cmd = [
        "ansible-playbook",
        "-i",
        "localhost,",
        "-c",
        "local",
        pbpath,
    ]
    cmd.extend(ansible_flags)
    subprocess.run(cmd, cwd=DF_DIR, check=True)


def main():
    parser = argparse.ArgumentParser(
        description="Dotfiles management solution with ansible"
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("install", help="install the dotfiles script")
    p_uninstall = subparsers.add_parser(
        "uninstall", help="remove installed script and config"
    )
    p_uninstall.add_argument(
        "-p", "--purge", help="delete config files when uninstalling"
    )
    subparsers.add_parser("update", help="update dotfiles repository")
    p_list = subparsers.add_parser(
        "list", aliases=["ls"], help="list tags in a playbook"
    )
    p_list.add_argument("-b", "--playbook", help="optional playbook name")
    p_list.add_argument(
        "ls_tags",
        nargs="*",
        metavar="TAGS",
        help="tags to include with ansible-playbook --tags",
    )
    p_list.add_argument(
        "-x",
        "--skip-tags",
        nargs="*",
        dest="ls_skip_tags",
        metavar="SKIP_TAGS",
        help="tags to skip with ansible-playbook --skip-tags",
    )
    p_run = subparsers.add_parser("run", help="run a playbook")
    p_run.add_argument("-b", "--playbook", help="specify playbook to run")
    p_run.add_argument(
        "tags", nargs="*", help="tags to include with ansible-playbook --tags"
    )
    p_run.add_argument(
        "-x",
        "--skip-tags",
        nargs="*",
        help="tags to skip with ansible-playbook --skip-tags",
    )
    p_run.add_argument(
        "-K", "--ask-pass", action="store_true", help="same as ansible-playbook -K"
    )

    if len(sys.argv) == 1:
        parser.print_help()
        exit(0)

    args = parser.parse_args()
    load_config()
    CONFIG["ask_pass"] = getattr(args, "ask_pass", False)

    if args.command == "help":
        parser.print_help()
    elif args.command == "uninstall":
        cmd_uninstall(args.purge)
    elif args.command == "update":
        cmd_update()
    elif args.command in ("list", "ls"):
        cmd_list(args.playbook, args.ls_tags, args.ls_skip_tags)
    elif args.command == "run":
        cmd_run(args.playbook, args.tags, args.skip_tags)
    else:
        bail(f"unknown command '{args.command}'")


if __name__ == "__main__":
    main()
