#!/usr/bin/env python3

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

DF_DIR = Path(__file__).resolve().parent.parent
DF_BIN_FILE = DF_DIR.joinpath("bin/dotfiles")
DF_INSTALL_LINK = Path.home() / ".local" / "bin" / "dotfiles"
DF_CONF_FILES = [
    DF_DIR.joinpath("dotfiles.conf"),
    Path("/etc/dotfiles.conf"),
]

CONFIG = {}


def bail(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def load_config():
    for p in DF_CONF_FILES:
        if not p.is_file():
            continue

        with open(p) as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue

                splits = s.split(maxsplit=1)
                if len(splits) != 2:
                    bail(f"config error: invalid syntax: '{s}'")

                CONFIG[splits[0]] = splits[1]
            return


def get_playbook_path(playbook: str | None) -> Path:
    if not playbook:
        playbook = CONFIG.get("playbook", "main")
    playbook_path = DF_DIR.joinpath(f"{playbook}.yml")

    if not playbook_path.is_file():
        bail(
            f"playbook '{playbook}' does not exist "
            f"(expected '{playbook_path}' to be a file)"
        )

    return playbook_path


def cmd_uninstall(purge: bool):
    if DF_INSTALL_LINK.is_symlink():
        target = DF_INSTALL_LINK.resolve()
        if target == DF_BIN_FILE.resolve():
            try:
                DF_INSTALL_LINK.unlink()
                print(f"removed symlink: {DF_INSTALL_LINK}")
            except PermissionError:
                bail(
                    f"cannot remove '{DF_INSTALL_LINK}' (permission denied) "
                    f"— re-run with sudo"
                )

    if DF_BIN_FILE.exists():
        print(f"removing script: {DF_BIN_FILE}")
        DF_BIN_FILE.unlink()

    if purge:
        for p in DF_CONF_FILES:
            if p.exists():
                print(f"removing config file: {p}")
                try:
                    p.unlink()
                except Exception as e:
                    print(f"failed to remove '{p}': {e}")

        if DF_DIR.exists():
            print(f"removing dotfiles directory: {DF_DIR}")
            shutil.rmtree(DF_DIR)


def cmd_update():
    git = ["git", "-C", str(DF_DIR)]
    branch = subprocess.run(
        [*git, "rev-parse", "--abbrev-ref", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()

    subprocess.run([*git, "fetch"], check=True)

    log = subprocess.run(
        [*git, "log", f"{branch}..origin/{branch}", "--oneline"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()

    if not log:
        print("Already up to date.")
        return

    subprocess.run([*git, "reset", "--hard", f"origin/{branch}"], check=True)


def cmd_list(playbook: str | None, tags: str, skip_tags: str, passthrough: list[str]):
    pbpath = get_playbook_path(playbook)

    ansible_flags = []
    if tags:
        ansible_flags.extend(["-t", tags])
    if skip_tags:
        ansible_flags.extend(["--skip-tags", skip_tags])

    cmd = [
        "ansible-playbook",
        pbpath,
        "-i",
        "localhost,",
        "--list-tags",
        "--list-tasks",
    ]
    cmd.extend(ansible_flags)
    cmd.extend(passthrough)
    subprocess.run(cmd, cwd=DF_DIR, check=True)


def cmd_run(playbook: str | None, tags: str, skip_tags: str, passthrough: list[str]):
    pbpath = get_playbook_path(playbook)
    print(f"Executing playbook: {pbpath}")

    ansible_flags = []
    if os.geteuid() != 0:
        pw = CONFIG.get("ansible_password")
        ask_pass = CONFIG.get("ask_pass")
        if pw:
            os.environ["DOTFILES_BECOME_PASS"] = pw
            ansible_flags.extend(
                [
                    "-e",
                    "ansible_become_pass={{ lookup('env', 'DOTFILES_BECOME_PASS') }}",
                ]
            )
        # default on macos is to not ask for password since it's usually not needed
        elif ask_pass or sys.platform != "darwin":
            ansible_flags.append("-K")

    if tags:
        print("Using tags:")
        print("\n".join(f"  - {t}" for t in tags.split(",")))
        ansible_flags.extend(["-t", tags])
    if skip_tags:
        print("Skipping tags:")
        print("\n".join(f"  - {t}" for t in skip_tags.split(",")))
        ansible_flags.extend(["--skip-tags", skip_tags])

    cmd = [
        "ansible-playbook",
        "-i",
        "localhost,",
        "-c",
        "local",
        pbpath,
    ]
    cmd.extend(ansible_flags)
    cmd.extend(passthrough)
    subprocess.run(cmd, cwd=DF_DIR, check=True)


def main():
    parser = argparse.ArgumentParser(
        description="Dotfiles management solution with ansible"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    p_uninstall = subparsers.add_parser(
        "uninstall", help="remove installed script and config"
    )
    p_uninstall.add_argument(
        "-p",
        "--purge",
        action="store_true",
        help="also delete config files and the dotfiles directory",
    )
    subparsers.add_parser("update", help="update dotfiles repository")
    p_list = subparsers.add_parser(
        "list", aliases=["ls"], help="list tags in a playbook"
    )
    p_list.add_argument("-b", "--playbook", help="optional playbook name")
    p_list.add_argument(
        "ls_tags",
        nargs="?",
        default="",
        metavar="TAGS",
        help="comma-separated tags to include (ansible-playbook --tags)",
    )
    p_list.add_argument(
        "-x",
        "--skip-tags",
        default="",
        dest="ls_skip_tags",
        metavar="SKIP_TAGS",
        help="comma-separated tags to skip (ansible-playbook --skip-tags)",
    )
    p_run = subparsers.add_parser("run", help="run a playbook")
    p_run.add_argument("-b", "--playbook", help="specify playbook to run")
    p_run.add_argument(
        "tags",
        nargs="?",
        default="",
        metavar="TAGS",
        help="comma-separated tags to include (ansible-playbook --tags)",
    )
    p_run.add_argument(
        "-x",
        "--skip-tags",
        default="",
        metavar="SKIP_TAGS",
        help="comma-separated tags to skip (ansible-playbook --skip-tags)",
    )
    p_run.add_argument(
        "-K", "--ask-pass", action="store_true", help="same as ansible-playbook -K"
    )

    if "--" in sys.argv:
        idx = sys.argv.index("--")
        passthrough = sys.argv[idx + 1 :]
        own_argv = sys.argv[1:idx]
    else:
        passthrough = []
        own_argv = sys.argv[1:]

    args = parser.parse_args(own_argv)
    load_config()
    if getattr(args, "ask_pass", False):
        CONFIG["ask_pass"] = True

    if args.command == "uninstall":
        cmd_uninstall(args.purge)
    elif args.command == "update":
        cmd_update()
    elif args.command in ("list", "ls"):
        cmd_list(args.playbook, args.ls_tags, args.ls_skip_tags, passthrough)
    elif args.command == "run":
        cmd_run(args.playbook, args.tags, args.skip_tags, passthrough)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
